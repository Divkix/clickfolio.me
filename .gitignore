# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# vinext / next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# worktrees
.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Cloudflare Workers
.wrangler/
.dev.vars
worker-configuration.d.ts
d1-backup-*.sql

# playwright
.playwright-mcp/

# Localflare generated files
.localflare/
/dist/

# Vendored anti-slop rules: `vendor/` is excluded by common global gitignore
# configs, which would drop the ESLint Stylistic rule, its LICENSE, and its
# provenance record that `anti-slop/require-readable-spacing` imports at runtime.
!tools/oxlint/anti-slop/vendor/
!tools/oxlint/anti-slop/vendor/**
