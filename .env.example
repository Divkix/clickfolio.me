# clickfolio.me - Environment Variables Template
# Copy this file to .env (gitignored) and fill in your values. `pnpm run dev` (alchemy dev) reads
# it: values here override the vars in alchemy.run.ts locally, and secrets left unset are absent.

# ============================================
# Authentication (Clerk)
# ============================================
# Sign-in/sign-up and user sessions are managed by Clerk.
# Keys come from the Clerk Dashboard: https://dashboard.clerk.com

# Publishable key (public — the root route reads it at request time and hands it to the client)
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Secret key (KEEP SECRET!) - server-side session verification and webhooks
CLERK_SECRET_KEY=sk_test_your-secret-key

# Svix signing secret for /api/webhooks/clerk (KEEP SECRET!)
# Configure a Clerk Dashboard webhook pointing at {APP_URL}/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# Pending Upload Claim Cookies
# ============================================
# HMAC secret that signs the pending-upload claim cookie between upload and
# resume claim. KEEP SECRET!
# Generate with: openssl rand -base64 32
PENDING_UPLOAD_SECRET=your-secret-key-here

# ============================================
# Email (Cloudflare Email Service)
# ============================================
# Parse-failure notifications use the EMAIL send_email binding in alchemy.run.ts.
# Requires Workers Paid and an onboarded sending domain in Cloudflare:
# Compute > Email Service > Email Sending > Onboard Domain.
# EMAIL_FROM is a var in alchemy.run.ts; keep the binding's allowedSenderAddresses in sync.
# Local sends are simulated.

# ============================================
# Application Configuration
# ============================================
# Canonical public URL of the app (no trailing slash).
# Used for canonical links, sitemaps, emails and local-environment detection.
# Development: http://localhost:3000
# Production: https://clickfolio.me
APP_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Parse Failure Alerting (OPTIONAL)
# ============================================
# Get notified when a ResumeParseWorkflow run permanently fails (after all step retries).
# Default: logs to Cloudflare Logpush (viewable in dashboard).
# Only configure if you want Slack/Discord webhook notifications.

# ALERT_CHANNEL=logpush
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# Cron Authentication (OPTIONAL)
# ============================================
# Bearer token for authenticating cron endpoint requests.
# If not set, cron endpoints skip authentication (not recommended for production).
# Generate with: openssl rand -base64 32

# CRON_SECRET=your-cron-secret-here

# ============================================
# Analytics reporting (Umami by default; browser trackers are independent)
# ============================================
# Production switches in alchemy.run.ts VARS; missing defaults to umami, other values fail.
ANALYTICS_SOURCE=umami
GA4_PROPERTY_ID=562314112
# Must match the GA4 property's IANA time zone; keep the Clickfolio property in Chicago.
GA4_TIME_ZONE=America/Chicago
# Required only for ga4: paste the complete service-account key as one-line JSON.
# Enable the Google Analytics Data API and grant its client_email Viewer access to the property.
# GA4_SERVICE_ACCOUNT_JSON=

# Self-hosted Umami instance for privacy-focused analytics
# Dashboard: https://analytics.divkix.me
# The website ID is public (the tracker script prints it); production sets it in alchemy.run.ts vars
UMAMI_WEBSITE_ID=your-umami-website-id

# Umami API credentials (for server-side stats proxy)
# These are used by the dashboard to fetch analytics data
# Get credentials from your Umami admin panel
UMAMI_API_URL=https://analytics.divkix.me
UMAMI_USERNAME=your-umami-username
UMAMI_PASSWORD=your-umami-password

# ============================================
# Browser telemetry (OpenObserve)
# ============================================
# Full OpenObserve Authorization header value the /otel proxy adds when it
# forwards browser traces, logs and session replay to OTEL_COLLECTOR_URL (a
# var in alchemy.run.ts): `Basic <base64 of user:token>`, from OpenObserve Data Sources →
# OpenTelemetry. Unset: the proxy accepts and drops the data. Production: a Worker secret
# (dashboard).
# OTEL_BROWSER_INGEST_KEY="Basic your-base64-credentials"

# ============================================
# AI Configuration (Resume Parsing)
# ============================================
# Resume parsing uses Vercel AI SDK with OpenRouter via Cloudflare AI Gateway.
# Get these from Cloudflare Dashboard > AI > Gateway
# CF_AI_GATEWAY_ACCOUNT_ID=your-account-id
# CF_AI_GATEWAY_ID=your-gateway-id
# CF_AIG_AUTH_TOKEN=your-auth-token

# AI Model for resume parsing (default: openai/gpt-6-luna:nitro)
# Options:
#   - openai/gpt-6-luna:nitro (default, latest OpenAI, reasoning med/high)
#   - openai/gpt-5-mini:nitro (previous, cheaper)
#   - deepseek/deepseek-v4-flash:nitro (cheapest)
#   - google/gemini-3.7-flash:nitro (balanced)
# The :nitro suffix routes to highest-throughput provider
# AI_MODEL=openai/gpt-6-luna:nitro
# AI_REASONING_EFFORT=medium  # low|medium|high|xhigh (default medium; higher effort spends more of the output token budget on reasoning)

# ============================================
# Database (PlanetScale Postgres via Hyperdrive)
# ============================================
# Runtime queries go through the HYPERDRIVE binding (see alchemy.run.ts). Locally it points at:
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clickfolio
#
# Direct migration tooling (db:migrate / db:push / db:studio) needs the direct
# PlanetScale connection string (PlanetScale console → clickfolio → Connect):
#
# DATABASE_URL=postgres://...

# ============================================
# Optional Configuration
# ============================================

# Rate limit: uploads per day per user (default: 5)
# RATE_LIMIT_UPLOADS_PER_DAY=5

# Disable rate limiting (development only)
# DISABLE_RATE_LIMITS=true

# ============================================
# Development Notes
# ============================================
#
# 1. NEVER commit .env to git (it's in .gitignore)
# 2. Keep service role keys and API tokens SECRET
# 3. Use different credentials for dev/staging/production
# 4. Rotate API tokens regularly for security
# 5. In production, encrypt sensitive variables in Cloudflare Dashboard
#
# Setup:
# - Copy this file to .env for local development
# - Set Clerk keys from the Clerk Dashboard; point a webhook at {APP_URL}/api/webhooks/clerk
# - Generate PENDING_UPLOAD_SECRET with: openssl rand -base64 32
# - Drizzle migration tooling reads DATABASE_URL (see drizzle.config.ts)
#
