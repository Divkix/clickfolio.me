{
  // Custom worker wraps vinext handler + adds queue consumer
  "main": "worker/index.ts",
  "name": "clickfolio-me",
  "compatibility_date": "2026-01-22",
  // Explicitly enable workers.dev subdomain (set to false if using custom domain only)
  "workers_dev": true,
  // Disable preview URLs to avoid confusion
  "preview_urls": false,
  // Custom domains (kept in config so CI deploy doesn't remove them)
  "routes": [
    {
      "pattern": "clickfolio.me",
      "zone_name": "clickfolio.me",
      "custom_domain": true,
    },
    {
      "pattern": "www.clickfolio.me",
      "zone_name": "clickfolio.me",
      "custom_domain": true,
    },
  ],
  // Bundle stubs are now handled by Vite's resolve.alias in vite.config.ts
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    // dist/client is the static asset directory produced by the vinext build.
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "placement": {
    // Cloudflare smart placement routes requests to the nearest data center.
    "mode": "smart",
  },
  // Hyperdrive → PlanetScale Postgres (logical DB `clickfolio` on `side-projects` cluster)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8132893bf32b4e0b8b1b7edc8dad16c1",
    },
  ],
  // R2 bucket binding for direct access (replaces AWS SDK for most operations)
  "r2_buckets": [
    {
      "binding": "CLICKFOLIO_R2_BUCKET",
      "bucket_name": "clickfolio-bucket",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "CLICKFOLIO_PARSE_QUEUE",
        "queue": "clickfolio-parse-queue",
      },
    ],
    "consumers": [
      {
        "queue": "clickfolio-parse-queue",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "clickfolio-parse-dlq",
      },
      {
        "queue": "clickfolio-parse-dlq",
        "max_batch_size": 1,
        "max_retries": 0,
      },
    ],
  },
  // Durable Objects for real-time WebSocket notifications
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICKFOLIO_STATUS_DO",
        "class_name": "ClickfolioStatusDO",
      },
    ],
  },
  "migrations": [
    {
      // v1: Initial migration creating the DOShardedTagCache Durable Object class.
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache"],
    },
    {
      // v2: Removed DOShardedTagCache and introduced ResumeStatusDO for real-time resume parsing status.
      "tag": "v2",
      "deleted_classes": ["DOShardedTagCache"],
      "new_classes": ["ResumeStatusDO"],
    },
    {
      // v3: Renamed ResumeStatusDO to ClickfolioStatusDO for broader real-time status tracking.
      "tag": "v3",
      "renamed_classes": [
        {
          "from": "ResumeStatusDO",
          "to": "ClickfolioStatusDO",
        },
      ],
    },
  ],
  "logpush": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  },
  // Cron Triggers for scheduled tasks
  "triggers": {
    "crons": [
      "0 2 * * *", // Daily at 2 AM UTC - R2 temp file cleanup
      "0 3 * * *", // Daily at 3 AM UTC - runs /api/cron/cleanup
      "*/15 * * * *", // Every 15 minutes - runs /api/cron/recover-orphaned
    ],
  },
  "vars": {
    // Environment variables are set via 'wrangler secret put' for production
    // and in .dev.vars for local development (vite loads these automatically)
    //
    // ===== REQUIRED SECRETS =====
    //   wrangler secret put PENDING_UPLOAD_SECRET       # HMAC key for signed pending-upload claim cookies
    //   wrangler secret put CLERK_SECRET_KEY            # sk_live_… — server-side session verification + webhook
    //   wrangler secret put CLERK_WEBHOOK_SECRET        # whsec_… — Svix signing secret for /api/webhooks/clerk
    //
    // ===== REQUIRED CONFIG (non-secret) =====
    //   APP_URL                            # canonical site URL (e.g. https://clickfolio.me)
    //   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  # public Clerk key — set in CF Workers dashboard/build env
    //
    // ===== OPTIONAL: DLQ alerting (defaults to Cloudflare Logpush) =====
    //   wrangler secret put ALERT_CHANNEL       # logpush | webhook
    //   wrangler secret put ALERT_WEBHOOK_URL   # Slack/Discord webhook URL
    //
    // ===== ANALYTICS (Umami) =====
    //   wrangler secret put NEXT_PUBLIC_UMAMI_WEBSITE_ID
    //   wrangler secret put UMAMI_API_URL
    //   wrangler secret put UMAMI_USERNAME
    //   wrangler secret put UMAMI_PASSWORD
    //
    // ===== ANALYTICS (PostHog) =====
    // No Worker env vars: the public project token + managed proxy host
    // (https://s.clickfolio.me) live in lib/analytics/config.ts, and source-
    // map upload credentials stay in gitignored local deploy env only.
    //
    // ===== AI PROVIDER (resume parsing) =====
    // Cloudflare AI Gateway (proxies to OpenRouter)
    //   wrangler secret put CF_AI_GATEWAY_ACCOUNT_ID
    //   wrangler secret put CF_AI_GATEWAY_ID
    //   wrangler secret put CF_AIG_AUTH_TOKEN
    //
    // Note: R2 is accessed via binding (CLICKFOLIO_R2_BUCKET) - no API credentials needed
    // NODE_ENV: Runtime environment for the Cloudflare Worker.
    "NODE_ENV": "production",
    "APP_URL": "https://clickfolio.me",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY2xpY2tmb2xpby5tZSQ",
    // AI_MODEL: OpenRouter model accessed via Cloudflare AI Gateway for resume parsing.
    "AI_MODEL": "openai/gpt-5.6-luna:nitro",
    // Reasoning effort (medium|high, default medium) — controls thinking tokens for reasoning models.
    "AI_REASONING_EFFORT": "medium",
  },
}
