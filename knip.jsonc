{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ is the entry point because app/ is imported by vinext at build time.
  "entry": ["scripts/**/*.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
    "proxy.ts",
    "instrumentation-client.ts",
    "global.d.ts",
  ],
  "ignore": [],
  "ignoreBinaries": [],
  "ignoreDependencies": [
    "cloudflare",
    "postcss",
    "tailwindcss",
    "tw-animate-css",
    "@tailwindcss/typography",
    "oxlint",
  ],
  "ignoreExportsUsedInFile": true,
}
