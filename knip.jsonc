{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ are tsx CLIs, alchemy.run.ts is the Alchemy CLI entry, and worker/index.ts is the Worker
  // entry it deploys (its class exports are bindings); no plugin knows about any of them.
  "entry": ["scripts/**/*.ts", "alchemy.run.ts", "worker/index.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
  ],
  // TanStack Start runs with `srcDirectory: "app"` (vite.config.ts); the plugin's defaults assume src/.
  // The generated route tree imports every route file.
  "tanstack-router": {
    "entry": ["app/routeTree.gen.ts", "app/{router,client}.tsx"],
  },
  "ignore": [],
  "ignoreBinaries": [],
  // Imported but not installed: `cloudflare:workers` reads as a package named "cloudflare" (a runtime builtin).
  // @tanstack/intent is only run as `pnpm exec intent` (AGENTS.md Skill Loading), never imported.
  "ignoreDependencies": ["cloudflare", "@tanstack/intent"],
  "ignoreExportsUsedInFile": true,
}
