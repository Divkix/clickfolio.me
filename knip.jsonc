{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ is the entry point because app/ is imported by vinext at build time.
  "entry": ["scripts/**/*.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
    "proxy.ts",
    "instrumentation-client.ts",
    "global.d.ts",
  ],
  "ignore": [],
  "ignoreBinaries": [],
  "ignoreDependencies": [
    // Tailwind CSS ecosystem and build-time dependencies:
    "cloudflare", // Cloudflare Workers `cloudflare:workers` runtime import
    "postcss", // Build-time CSS processor
    "tailwindcss", // Utility-first CSS framework
    "tw-animate-css", // Tailwind CSS animation plugin
    "@tailwindcss/typography", // Tailwind CSS prose plugin
    "oxlint", // Used via `vp check` / `vp lint` (vite-plus), not directly imported
  ],
  "ignoreExportsUsedInFile": true,
}
