{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ is the entry point because app/ is imported by vinext at build time.
  // lib/cache/queued-cdn-adapter.ts is loaded by path from vite.config.ts (vinext cache.cdn.adapter).
  "entry": ["scripts/**/*.ts", "lib/cache/queued-cdn-adapter.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
  ],
  "ignore": [],
  "ignoreBinaries": [],
  // `cloudflare:workers` imports read as a package named "cloudflare" (a runtime builtin, not installed).
  "ignoreDependencies": ["cloudflare", "postcss"],
  "ignoreExportsUsedInFile": true,
}
