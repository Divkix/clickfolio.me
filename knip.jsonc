{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ is the entry point because app/ is imported by vinext at build time.
  "entry": ["scripts/**/*.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
  ],
  "ignore": [],
  "ignoreBinaries": [],
  "ignoreDependencies": ["cloudflare", "postcss"],
  "ignoreExportsUsedInFile": true,
}
