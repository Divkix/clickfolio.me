{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  // scripts/ are tsx CLIs, which no plugin knows about.
  "entry": ["scripts/**/*.ts"],
  "project": [
    "app/**/*.{ts,tsx}",
    "app/**/*.css",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "worker/**/*.{ts,tsx}",
  ],
  // TanStack Start runs with `srcDirectory: "app"` (vite.config.ts); the plugin's defaults assume src/.
  // The generated route tree imports every route file.
  "tanstack-router": {
    "entry": ["app/routeTree.gen.ts", "app/{router,client}.tsx"],
  },
  "ignore": [],
  "ignoreBinaries": [],
  // Imported but not installed: `cloudflare:workers` reads as a package named "cloudflare" (a runtime builtin).
  "ignoreDependencies": ["cloudflare", "postcss"],
  "ignoreExportsUsedInFile": true,
}
