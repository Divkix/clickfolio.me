{
  "name": "clickfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "start": "vp preview",
    "lint": "vp lint",
    "fix": "vp check --fix",
    "format": "vp fmt",
    "check": "vp check",
    "knip": "knip",
    "verify": "pnpm run check && pnpm run type-check && pnpm run knip",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist",
    "test": "vp test run",
    "test:integration": "vp test run --project integration",
    "test:security": "vp test run --project security",
    "test:coverage": "vp test run --coverage",
    "test:ci": "vp test run --coverage --reporter=json",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "ci": "pnpm install --frozen-lockfile && pnpm run verify && pnpm run test && pnpm run build",
    "preview": "vp build && pnpm exec wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 4984",
    "analyze": "ANALYZE=true vp build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv lib/cloudflare-env.d.ts",
    "generate:favicons": "tsx scripts/generate-favicons.ts",
    "seo:lastmod": "tsx scripts/bump-lastmod.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@cf-wasm/resvg": "^0.4.0",
    "@clerk/backend": "^3.23.2",
    "@clerk/react": "^6.17.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@neoconfetti/react": "^1.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "ai": "^7.0.141",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "effect": "4.0.5",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.10",
    "posthog-node": "^5.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "svix": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@electric-sql/pglite": "^0.5.10",
    "@posthog/rollup-plugin": "^1.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.41.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.30",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vinext": "^1.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.6.0"
}
