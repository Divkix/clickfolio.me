{
  "name": "clickfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "start": "vp preview",
    "lint": "vp lint",
    "fix": "vp check --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next dist",
    "test": "vp test run",
    "test:unit": "vp test run --config vitest.unit.config.ts",
    "test:integration": "vp test run --config vitest.integration.config.ts",
    "test:security": "vp test run --config vitest.security.config.ts",
    "test:coverage": "vp test run --coverage",
    "test:ci": "vp test run --coverage --reporter=json",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "ci": "pnpm install --frozen-lockfile && pnpm run type-check && vp check && pnpm run test && pnpm run build",
    "preview": "vp build && pnpm exec wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 4984",
    "analyze": "ANALYZE=true vp build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv lib/cloudflare-env.d.ts",
    "generate:favicons": "tsx scripts/generate-favicons.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@cf-wasm/resvg": "^0.4.0",
    "@clerk/backend": "^3.16.12",
    "@clerk/react": "^6.14.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@neoconfetti/react": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "ai": "^7.0.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.419.4",
    "posthog-node": "^5.51.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "sonner": "^2.0.8",
    "svix": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "uplot": "^1.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@oxlint/plugins": "1.80.0",
    "@posthog/rollup-plugin": "^1.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "oxlint": "1.80.0",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.8",
    "vite": "catalog:",
    "vite-plus": "^0.3.0",
    "vitest": "catalog:",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.10.0"
}
